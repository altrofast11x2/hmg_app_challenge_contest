<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 이하용 백업 제외 규칙. allowBackup="false"로 이미 꺼져 있지만, 운행기록·설정이 백업에 실리지 않도록
     모든 영역을 제외해 둔다 (Pleos 앱 보안 가이드: 민감 데이터는 백업 대상에서 제외). Android 12 이상은 data_extraction_rules -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
