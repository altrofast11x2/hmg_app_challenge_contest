# backend/.env 로 복사해서 채운다. backend/.env 는 절대 커밋하지 않는다 (.gitignore에 있음)

# Supabase 프로젝트 주소 (Project Settings > API)
SUPABASE_URL=https://<project-ref>.supabase.co

# 관리용 키: Project Settings > API Keys 의 Secret key(sb_secret_...) 또는 Legacy 탭의 service_role 키.
# 서버 작업(seed)에서만 쓰고 앱·웹에는 절대 넣지 않는다
SUPABASE_SERVICE_ROLE_KEY=

# setup.mjs 로 SQL 적용과 익명 로그인 켜기를 자동으로 할 때만 필요 (supabase.com > Account > Access Tokens)
SUPABASE_ACCESS_TOKEN=

# 시연용 데모 조직과 관리자 계정
DEMO_ORG_NAME=AltroStudio 데모
# 데모 기업 관리자 계정 (관리자 웹 로그인 아이디)
DEMO_ADMIN_EMAIL=demo@altro.com
DEMO_ADMIN_PASSWORD=
# 심사·시연용 6자리 연결 코드 (여러 번 쓸 수 있고 2027-02-28까지 유효)
DEMO_PAIRING_CODE=

# 개발자(서비스 운영) 계정: 관리자 웹에서 기업을 등록한다
DEMO_DEVELOPER_EMAIL=AltroStudio@altro.com
DEMO_DEVELOPER_PASSWORD=
