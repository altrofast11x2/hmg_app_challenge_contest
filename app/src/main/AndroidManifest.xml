<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 차량 데이터 권한은 실제로 쓰는 기능만 선언한다 (docs/sdk-usage.md) -->
    <!-- 계기판 누적 거리 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 차량 식별번호(VIN) -->
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <!-- 연비·전비 -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- 운행 시작·종료 주소, 목적지·경유지 도착 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- AAOS 기어(GEAR_SELECTION), 주차 브레이크(PARKING_BRAKE_ON) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- 음성 안내 (Pleos TextToSpeech, 차량 안 음성 엔진) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- 말로 용도·업무 내용 기록 (Pleos SpeechToText, 차량 안 음성 인식 엔진. 녹음은 앱이 받지 않음) -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <!-- 공용차 운전자 맞춤: 운전석 공조 온도 읽기·바꾸기 -->
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />
    <!-- 공용차 운전자 맞춤: 운전석 시트 열선·통풍 읽기·바꾸기 -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_SEATS" />
    <!-- 무드등 신호(분류 대기·분류 결과)와 맞춤 무드등 색, 하차 점검의 실내등 확인 (읽기·무드등 색은 CAR_LIGHTS) -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <!-- 하차 점검 [한 번에 정리]: 실내등 끄기 -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <!-- 하차 점검: 열린 창문 확인, [한 번에 정리]의 창문 닫기 -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_WINDOWS" />
    <!-- 하차 점검: 문 잠김 확인, [문 잠그기] -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_DOORS" />

    <!-- 앱 화면이 닫혀 있어도 운행을 감지하는 포그라운드 서비스, 차량이 켜지면 다시 시작 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 조직에 연결한 차량만 서버(Supabase)와 통신한다: 연결 코드 확인, 운행 업로드 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 운행기록(개인정보)은 백업하지 않는다. Android 12+의 기기 간 이전은 data_extraction_rules로 막는다 -->
    <application
        android:name=".DriveLogApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DriveLog"
        tools:targetApi="31">
        <!-- 다이얼·물리 버튼(CCP) 포커스 조작은 지원하지 않는다. 모든 조작은 터치로 끝낼 수 있다 (Pleos CCP 개발 가이드) -->
        <meta-data
            android:name="com.hmg.rotary.ROTARY_SUPPORTED"
            android:value="false" />

        <!-- AAOS Car API. 차량 OS가 아닌 기기(테스트용 폰 에뮬레이터)에서도 설치되도록 필수로 두지 않는다 -->
        <uses-library
            android:name="android.car"
            android:required="false" />

        <!-- 주행 중에도 시스템이 가리지 않도록 주의 분산 최적화로 선언한다.
             주행 중에는 앱이 스스로 터치 요소가 없는 주행 중 화면만 보여 준다 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.DriveLog">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <service
            android:name=".service.TripRecorderService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vehicle_trip_logging" />
        </service>

        <!-- Gleo AI 음성 명령 (assets/schema.json의 함수, component "service"). Gleo AI가 이 앱을 지정해 보내므로 노출한다.
             받는 일은 운행 용도·업무 내용 기록, 운전자 바꾸기, 기록부 요약뿐이다 (Pleos 앱 연동 가이드) -->
        <receiver
            android:name=".service.GleoActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="RECORD_TRIP_PURPOSE" />
                <action android:name="SET_DRIVER" />
                <action android:name="GET_DRIVING_SUMMARY" />
            </intent-filter>
        </receiver>

        <!-- 시스템의 부팅 완료·앱 업데이트 방송만 받으면 되므로 다른 앱에 노출하지 않는다 (Pleos 앱 보안 가이드) -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- 앱 업데이트 직후 기록 서비스를 다시 켠다 -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
